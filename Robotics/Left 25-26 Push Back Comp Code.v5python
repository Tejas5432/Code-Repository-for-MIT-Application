{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nLeft_motor_a = Motor(Ports.PORT2, GearSetting.RATIO_18_1, True)\nLeft_motor_b = Motor(Ports.PORT4, GearSetting.RATIO_18_1, True)\nLeft = MotorGroup(Left_motor_a, Left_motor_b)\nRight_motor_a = Motor(Ports.PORT3, GearSetting.RATIO_18_1, False)\nRight_motor_b = Motor(Ports.PORT5, GearSetting.RATIO_18_1, False)\nRight = MotorGroup(Right_motor_a, Right_motor_b)\ncontroller_1 = Controller(PRIMARY)\nintake_motor_a = Motor(Ports.PORT6, GearSetting.RATIO_18_1, True)\nintake_motor_b = Motor(Ports.PORT7, GearSetting.RATIO_18_1, False)\nintake = MotorGroup(intake_motor_a, intake_motor_b)\nbelt = Motor(Ports.PORT9, GearSetting.RATIO_18_1, False)\ndescorer = DigitalOut(brain.three_wire_port.a)\naccelerator = Motor(Ports.PORT15, GearSetting.RATIO_6_1, False)\n\n\n# wait for rotation sensor to fully initialize\nwait(30, MSEC)\n\n\n# Make random actually random\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    random = brain.battery.voltage(MV) + brain.battery.current(CurrentUnits.AMP) * 100 + brain.timer.system_high_res()\n    urandom.seed(int(random))\n      \n# Set random seed \ninitializeRandomSeed()\n\n\ndef play_vexcode_sound(sound_name):\n    # Helper to make playing sounds from the V5 in VEXcode easier and\n    # keeps the code cleaner by making it clear what is happening.\n    print(\"VEXPlaySound:\" + sound_name)\n    wait(5, MSEC)\n\n# add a small delay to make sure we don't print in the middle of the REPL header\nwait(200, MSEC)\n# clear the console to make sure we don't have the REPL in the console\nprint(\"\\033[2J\")\n\n#endregion VEXcode Generated Robot Configuration\n\nmyVariable = 0\n\ndef when_started1():\n    global myVariable\n    pass\n\ndef onauton_autonomous_0():\n    Left.set_max_torque(100,PERCENT)\n    Right.set_max_torque(100,PERCENT)\n    Left.set_velocity(30,PERCENT)\n    Right.set_velocity(30,PERCENT)\n    intake.set_velocity(100,PERCENT)\n    intake.set_max_torque(100,PERCENT)\n    belt.set_velocity(40,PERCENT)\n    accelerator.set_velocity(100,PERCENT)\n    accelerator.set_max_torque(100,PERCENT)\n    global myVariable\n\n    # auton left\n    #part 1\n    #forward\n    intake.spin(FORWARD)\n    Left.spin(FORWARD)\n    Right.spin(FORWARD)\n    wait(0.7,SECONDS)\n    #align\n    Left.spin(FORWARD)\n    Right.spin(REVERSE)\n    wait(0.42,SECONDS)\n    Left.stop()\n    Right.stop()\n    wait(0.2,SECONDS)\n    Left.set_velocity(20,PERCENT)\n    Right.set_velocity(20,PERCENT)\n    belt.spin(FORWARD)\n    Left.spin(FORWARD)\n    Right.spin(FORWARD)\n    wait(2,SECONDS)\n    Left.stop()\n    Right.stop()\n    wait(1,SECONDS)\n    belt.stop()\n    Left.spin(REVERSE)\n    Right.spin(REVERSE)\n    wait(1,SECONDS)\n    Left.stop()\n    Right.stop()\n    # part 2\n    wait(0.2,SECONDS)\n    Left.set_velocity(10,PERCENT)\n    Right.set_velocity(10,PERCENT)\n    Left.spin(FORWARD)\n    Right.spin(REVERSE)\n    wait(1,SECONDS)\n    Left.stop()\n    Right.stop()\n    Left.set_velocity(30,PERCENT)\n    Right.set_velocity(30,PERCENT)\n    belt.spin(FORWARD)\n    Left.spin(FORWARD)\n    Right.spin(FORWARD)\n    wait(1.2,SECONDS)\n    Left.stop()\n    Right.stop()\n    wait(1,SECONDS)\n    accelerator.set_velocity(50,PERCENT)\n    accelerator.spin(REVERSE)\n    ##########################\n    # wait(1,SECONDS)\n    # Left.set_velocity(20,PERCENT)\n    # Right.set_velocity(20,PERCENT)\n    # belt.spin(FORWARD)\n    # Left.spin(REVERSE)\n    # Right.spin(REVERSE)\n    # wait(3,SECONDS)\n    # Left.stop()\n    # Right.stop()\n    # belt.stop()\n    # Left.spin(REVERSE)\n    # Right.spin(FORWARD)\n    # wait(0.33,SECONDS)\n    # Left.spin(FORWARD)\n    # Right.spin(FORWARD)\n    # wait(0.7,SECONDS)\n    # Left.stop()\n    # Right.stop()\n    # accelerator.set_velocity(100,PERCENT)\n    # belt.set_velocity(100,PERCENT)\n    # accelerator.spin(FORWARD)\n    # belt.spin(FORWARD)\ndef ondriver_drivercontrol_0():\n    global myVariable\n    while True:\n        if controller_1.buttonL1.pressing():\n            intake.spin(FORWARD,100,PERCENT)\n        elif controller_1.buttonL2.pressing():\n            intake.spin(REVERSE,100,PERCENT)\n        else:\n            intake.stop()\n        if controller_1.buttonA.pressing():\n            accelerator.spin(FORWARD,100,PERCENT)\n        elif controller_1.buttonB.pressing():\n            accelerator.spin(REVERSE,100,PERCENT)\n        else:\n            accelerator.stop()\n        Left.set_max_torque(100,PERCENT)\n        Right.set_max_torque(100,PERCENT)\n        accelerator.set_max_torque(100,PERCENT)\n        Left_and_right_percentage = (controller_1.axis1.position())*-1\n        Forward_and_backward_percentage = controller_1.axis3.position()\n        Left_amount = (Forward_and_backward_percentage - Left_and_right_percentage)\n        Right_amount = (Forward_and_backward_percentage + Left_and_right_percentage)\n        Left.set_velocity(Left_amount,PERCENT)\n        Right.set_velocity(Right_amount,PERCENT)\n        Left.spin(FORWARD)\n        Right.spin(FORWARD)\n        if controller_1.buttonR1.pressing():\n            belt.spin(FORWARD,100,PERCENT)\n        elif controller_1.buttonR2.pressing():\n            belt.spin(REVERSE,100,PERCENT)\n        else:\n            belt.stop()\n        if controller_1.buttonRight.pressing():\n            descorer.set(True)\n        if controller_1.buttonDown.pressing():\n            descorer.set(False)\n# create a function for handling the starting and stopping of all autonomous tasks\ndef vexcode_auton_function():\n    # Start the autonomous control tasks\n    auton_task_0 = Thread( onauton_autonomous_0 )\n    # wait for the driver control period to end\n    while( competition.is_autonomous() and competition.is_enabled() ):\n        # wait 10 milliseconds before checking again\n        wait( 10, MSEC )\n    # Stop the autonomous control tasks\n    auton_task_0.stop()\n\ndef vexcode_driver_function():\n    # Start the driver control tasks\n    driver_control_task_0 = Thread( ondriver_drivercontrol_0 )\n\n    # wait for the driver control period to end\n    while( competition.is_driver_control() and competition.is_enabled() ):\n        # wait 10 milliseconds before checking again\n        wait( 10, MSEC )\n    # Stop the driver control tasks\n    driver_control_task_0.stop()\n\n\n# register the competition functions\ncompetition = Competition( vexcode_driver_function, vexcode_auton_function )\n\nwhen_started1()\n","textLanguage":"python","robotConfig":[{"port":[2,4],"name":"Left","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"true","motor_b_reversed":"true"},"triportSourcePort":22},{"port":[3,5],"name":"Right","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"false","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[],"name":"controller_1","customName":false,"deviceType":"Controller","deviceClass":"controller","setting":{"left":"","leftDir":"false","right":"","rightDir":"false","upDown":"","upDownDir":"false","xB":"","xBDir":"false","drive":"none","id":"primary"},"triportSourcePort":22},{"port":[6,7],"name":"intake","customName":true,"deviceType":"MotorGroup","deviceClass":"motor_group","setting":{"fwd":"forward","rev":"reverse","gear":"ratio18_1","motor_a_reversed":"true","motor_b_reversed":"false"},"triportSourcePort":22},{"port":[9],"name":"belt","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio18_1","id":"partner"},"triportSourcePort":22},{"port":[1],"name":"descorer","customName":true,"deviceType":"DigitalOut","deviceClass":"digital_out","setting":{"id":"partner"},"triportSourcePort":22},{"port":[15],"name":"accelerator","customName":true,"deviceType":"Motor","deviceClass":"motor","setting":{"reversed":"false","fwd":"forward","rev":"reverse","gear":"ratio6_1"},"triportSourcePort":22}],"slot":0,"platform":"V5","sdkVersion":"20240802.15.00.00","appVersion":"4.68.0","minVersion":"4.60.0","fileFormat":"2.0.0","targetBrainGen":"First","v5Sounds":[{"name":"game over","url":"static/sounds/mixkit-arcade-retro-game-over-213.wav"}],"v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null},"target":"Physical"}